<Window x:Class="RevitCopyParams.ParamForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор параметров" Height="400" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="grid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          SelectionUnit="FullRow"
          SelectionMode="Extended"
          IsReadOnly="False">

            <DataGrid.Columns>

                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.Header>
                        <CheckBox Click="HeaderCheckBox_Click"/>
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="У хоста" Binding="{Binding HostValue}" Width="150"/>
                <DataGridTextColumn Header="У изоляции" Binding="{Binding InsValue}" Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1"
                Content="OK"
                Width="80"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="Ok_Click"/>
    </Grid>
</Window>