<Window x:Class="RevitCopyParams.ChangeJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitCopyParams"
        Title="Журнал изменений"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <SolidColorBrush
        x:Key="UnreadBrush"
        Color="#3A86D1"/>

        <SolidColorBrush
        x:Key="ReadBrush"
        Color="#A0A0A0"/>

        <local:ChangeStatusToTextConverter
        x:Key="StatusTextConverter"/>

        <local:ChangeStatusToBrushConverter
        x:Key="StatusBrushConverter"/>

    </Window.Resources>



    <DockPanel Margin="10">

        <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <Button
                x:Name="btnAdd"
                Width="170"
                Height="35"
                Click="btnAdd_Click">

                Добавить изменение

            </Button>

        </StackPanel>

        <ListView x:Name="lvJournal"
          MouseDoubleClick="lvJournal_MouseDoubleClick"
          KeyDown="lvJournal_KeyDown">

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border
            BorderBrush="#D8D8D8"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,8"
            Padding="10">

                        <StackPanel>

                            <!-- Здесь позже появится статус -->
                            <StackPanel Orientation="Horizontal">

                                <Ellipse
        Width="10"
        Height="10"
        Margin="0,2,6,0"
        Fill="{Binding Status,
                       Converter={StaticResource StatusBrushConverter}}"/>

                                <TextBlock
        FontWeight="SemiBold"
        Foreground="{Binding Status,
                             Converter={StaticResource StatusBrushConverter}}"
        Text="{Binding Status,
                       Converter={StaticResource StatusTextConverter}}"/>

                            </StackPanel>

                            <TextBlock
    Margin="0,4,0,0"
    Text="{Binding CreatedDate,
                   StringFormat=dd.MM.yyyy HH:mm}"
    FontWeight="Bold"/>

                            <StackPanel
                    Orientation="Horizontal"
                    Margin="0,4,0,0">

                                <TextBlock
                        Text="{Binding SourceModel}"
                        FontWeight="SemiBold"/>

                                <TextBlock
                        Text=" → "
                        FontWeight="SemiBold"/>

                                <TextBlock
                        Text="{Binding TargetModelsText}"/>

                            </StackPanel>

                            <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding Description}"
                    TextWrapping="Wrap"
                    FontSize="13"/>

                            <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding Author}"
                    Foreground="Gray"
                    FontSize="11"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </DockPanel>

</Window>