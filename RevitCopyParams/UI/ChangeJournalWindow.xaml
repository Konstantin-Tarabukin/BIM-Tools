<Window x:Class="RevitCopyParams.ChangeJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал изменений"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <Button
                x:Name="btnAdd"
                Width="170"
                Height="35"
                Click="btnAdd_Click">

                Добавить изменение

            </Button>

        </StackPanel>

        <ListView x:Name="lvJournal">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5"
                Margin="0,0,0,8"
                Padding="8">

                        <StackPanel>

                            <TextBlock
                        Text="{Binding CreatedDate}"
                        FontWeight="Bold"/>

                            <TextBlock
                        Text="{Binding Author}"/>

                            <TextBlock
                        Text="{Binding Disciplines}"/>

                            <TextBlock
                        Text="{Binding Description}"
                        Margin="0,5,0,0"
                        TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </DockPanel>

</Window>