<Window x:Class="RevitCopyParams.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Tools"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <TextBlock
            DockPanel.Dock="Top"
            Text="Новые изменения"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,0,0,10"/>

        <Button
            DockPanel.Dock="Bottom"
            Content="OK"
            Width="80"
            Height="30"
            HorizontalAlignment="Right"
            Margin="0,10,0,0"
            Click="Ok_Click"/>

        <ListView x:Name="lvNotifications">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5"
        Margin="0,0,0,8"
        Padding="10">

                        <StackPanel>

                            <TextBlock
                FontWeight="Bold"
                FontSize="14"
                Text="{Binding Description}"
                TextWrapping="Wrap"/>

                            <Separator Margin="0,6,0,6"/>

                            <TextBlock>
                <Run FontWeight="Bold"
                     Text="Дата: "/>
                <Run Text="{Binding CreatedDate}"/>
                            </TextBlock>

                            <TextBlock Margin="0,2,0,0">
                <Run FontWeight="Bold"
                     Text="От модели: "/>
                <Run Text="{Binding SourceModel}"/>
                            </TextBlock>

                            <TextBlock Margin="0,2,0,0">
                <Run FontWeight="Bold"
                     Text="Автор: "/>
                <Run Text="{Binding Author}"/>
                            </TextBlock>

                            <TextBlock Margin="0,2,0,0">
                <Run FontWeight="Bold"
                     Text="Получатели: "/>
                <Run Text="{Binding TargetModelsText}"/>
                            </TextBlock>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </DockPanel>

</Window>