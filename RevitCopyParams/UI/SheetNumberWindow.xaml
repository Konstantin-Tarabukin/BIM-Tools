<Window x:Class="RevitCopyParams.UI.SheetNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:model="clr-namespace:RevitCopyParams.Models"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нумератор листов"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="900"
        MinHeight="600">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.3*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- Левая часть -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

            <TreeView x:Name="treeSheets"
          SelectedItemChanged="treeSheets_SelectedItemChanged">

                <TreeView.Resources>

                    <HierarchicalDataTemplate
            DataType="{x:Type model:SheetNode}"
            ItemsSource="{Binding Children}">

                        <TextBlock Text="{Binding Name}" />

                    </HierarchicalDataTemplate>

                </TreeView.Resources>

            </TreeView>

        </Border>

        <!-- ================================================= -->
        <!-- Правая часть -->
        <!-- ================================================= -->

        <Grid Grid.Column="2">

            <Grid.RowDefinitions>

                <!-- Префикс -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>

                <!-- Поле префикса -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>

                <!-- Суффикс -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>

                <!-- Галочка -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>

                <!-- Предпросмотр -->
                <RowDefinition Height="*"/>

                <RowDefinition Height="15"/>

                <!-- Кнопка -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- Префикс -->

            <TextBlock
                Text="Префикс"
                FontWeight="SemiBold"/>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="70"/>

                </Grid.ColumnDefinitions>

                <TextBox x:Name="tbPrefix"
         Height="28"
         VerticalContentAlignment="Center"
         TextChanged="PrefixSuffix_TextChanged"/>

                <Button
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Content="Юникод"
                    x:Name="btnPrefixUnicode"
                Click="btnPrefixUnicode_Click"/>

            </Grid>

            <!-- Суффикс -->

            <StackPanel Grid.Row="4">

                <TextBlock
                    Text="Суффикс"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="70"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="tbSuffix"
         Height="28"
         VerticalContentAlignment="Center"
         TextChanged="PrefixSuffix_TextChanged"/>

                    <Button
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Content="Юникод"
                        x:Name="btnSuffixUnicode"
                        Click="btnSuffixUnicode_Click"/>

                </Grid>

            </StackPanel>


            <!-- Предпросмотр -->
            <CheckBox
    Grid.Row="6"
    x:Name="cbShowUnicode"
    Content="Показывать управляющие символы Юникода"
    Checked="cbShowUnicode_Changed"
    Unchecked="cbShowUnicode_Changed"/>
            <GroupBox
                Grid.Row="8"
                Header="Предпросмотр">

                <ListBox
                    x:Name="lbPreview"/>

            </GroupBox>


            <!-- Кнопка -->

            <Button
                Grid.Row="10"
                Width="130"
                Height="35"
                HorizontalAlignment="Right"
                Content="Применить"
                x:Name="btnApply"
                Click="btnApply_Click"/>

        </Grid>

    </Grid>

</Window>